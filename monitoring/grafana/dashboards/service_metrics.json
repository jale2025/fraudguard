    {
      "id": 5,
      "title": "Failed Requests (since API start)",
      "description": "Cumulative number of prediction requests with result invalid_input, model_unavailable or internal_error, since the api-service process started. HTTP 422 request-validation errors are handled by FastAPI before the endpoint body and are NOT counted here.",
      "type": "stat",
      "gridPos": {
