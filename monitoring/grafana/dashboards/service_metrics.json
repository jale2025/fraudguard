    {
      "id": 3,
      "title": "Prediction Requests (since API start)",
      "description": "Cumulative number of requests handled by the four prediction endpoints since the api-service process started. Resets when the container restarts. Requests rejected by FastAPI's request validation (HTTP 422) never reach the handler and are not counted.",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 8,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "decimals": 0,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "editorMode": "code",
          "expr": "sum(fraudguard_prediction_requests_total) or vector(0)",
          "instant": true,
          "legendFormat": "Requests",
          "range": false,
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Successful Requests (since API start)",
